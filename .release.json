{
  "branch": "main",
  "sign_tag": true,
  "version_files": [],
  "checks": [
    [
      "xcodebuild",
      "-project",
      "Harvie.xcodeproj",
      "-scheme",
      "Harvie",
      "-configuration",
      "Debug",
      "-destination",
      "platform=macOS",
      "-derivedDataPath",
      "/tmp/Harvie-release-check",
      "-onlyUsePackageVersionsFromResolvedFile",
      "CODE_SIGN_IDENTITY=-",
      "CODE_SIGNING_REQUIRED=NO",
      "CODE_SIGNING_ALLOWED=NO",
      "test"
    ]
  ],
  "stable_only": true
}
